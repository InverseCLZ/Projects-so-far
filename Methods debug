import java.util.Scanner;

//----------------------------------------------------------------------------------------------------------------------


public class Methods {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
//----------------------------------------------------------------------------------------------------------------------

// Problem 2 - factorial method
        System.out.println("Problem 2: Factorial");
        System.out.print("Enter a number: ");
        int num = scanner.nextInt();
        int factorial = findFactorial(num);
        System.out.println("Factorial of " + num + " is: " + factorial);
//----------------------------------------------------------------------------------------------------------------------
// Problem 3 - sum method
        System.out.println("Problem 3: Sum of every other number");
        System.out.print("Enter a number: ");
        int n = scanner.nextInt();
        int sum = sumEveryOtherNumber(n);
        System.out.println("Sum of every other number up to " + n + " is: " + sum);
//----------------------------------------------------------------------------------------------------------------------

// Problem 5 - reverse method
        System.out.println("Problem 5: Reverse a string");
        System.out.print("Enter a word: ");
        String word = scanner.next();
        String reversed = reverseWord(word);
        System.out.println("Reversed word: " + reversed);
//----------------------------------------------------------------------------------------------------------------------
        scanner.close();  // done w scanner here
    }
//----------------------------------------------------------------------------------------------------------------------

    // Problem 2 - find factorial
    public static int findFactorial(int num) {
        int result = 1;
        for (int i = 1; i <= num; i++) {    //MATH COMPLETE
            result = result * i;  // easy mulltiply here
        }
        return result; //(returning whatever function gave )
    }
//----------------------------------------------------------------------------------------------------------------------

    // Problem 3 - sum every other number
    public static int sumEveryOtherNumber(int n) {
        int sum = 0;
        for (int i = 1; i <= n; i = i + 2) {  // +2 each time   //MATH COMPLETE
            sum = sum + i;  // add with sum
        }
        return sum; //(returning whatever function gave )
    }
//----------------------------------------------------------------------------------------------------------------------

    // Problem 5: Method to reverse a word
    public static String reverseWord(String word) {
        String reversed = "";  // string empty at rfirst
        for (int i = word.length() - 1; i >= 0; i--) {  // Loop backward in word   //MATH COMPLETE
            reversed = reversed + word.charAt(i);  // Add each character reversed
        }
        return reversed; //(returning whatever function gave )
    }
}
